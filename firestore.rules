rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 抽選データはすべて検証済みCloud Functions経由で扱う。
    // 管理画面を含め、ブラウザからの直接読み書きは許可しない。
    match /lotteryRuntime/{document} { allow read, write: if false; }
    match /lotteryEntries/{document} { allow read, write: if false; }
    match /lotteryIdentifiers/{document} { allow read, write: if false; }
    match /lotteryTokens/{document} { allow read, write: if false; }
    match /lotteryAuditLogs/{document} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
